# Inject via the process environment or ~/.newton/.env — never commit values.
# This file is a name checklist only.

PRIVATE_KEY=
RPC_URL=
NEWTON_API_KEY=

# Pack oracle secrets — only the names your policy actually requires.
# Upload uses VAULTS_FYI_API_KEY; VAULTSFYI_API_KEY is a local alias.
VAULTS_FYI_API_KEY=
VAULTSFYI_API_KEY=
# CHAINALYSIS_SANCTIONS_KEY=
# CHAINALYSIS_SCREENING_KEY=
# WEBACY_API_KEY=

# Per-call pack inputs. Same calldata; change the address between allow and deny.
# WEBACY_ADDRESS=
# CHAINALYSIS_ADDRESS=
# VAULTSFYI_NETWORK=mainnet
# VAULTSFYI_VAULT=
# VAULTSFYI_PREVIOUS_ALLOCATION_HASH=

# ABI-encoded manager call. Do not hand-write this; encodeFunctionData from the vault ABI.
# CALLDATA=
# FUNCTION_SIGNATURE=

# Existing vault Newton does not own. Do not invent this address.
VAULT=

# Path to newton-policy output (policy must be filled for live createShield).
POLICY_HANDOFF=
